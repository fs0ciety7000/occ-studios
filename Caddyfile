# Coolify's proxy (Traefik) terminates TLS for studios.fs0ciety.org and forwards plain HTTP here.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	respond /healthz 200

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Hashed build assets never change.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@media path /projects/* /brand/* /og-image.jpg /favicon.png /apple-touch-icon.png
	header @media Cache-Control "public, max-age=604800"

	@html path / *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	try_files {path} {path}.html {path}/index.html
	file_server {
		precompressed br gzip
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server {
			precompressed br gzip
		}
	}
}
